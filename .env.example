# Copy to .env and fill in. Never commit .env. Details: docs/SETUP.md

# --- Shared by the server and the bot -------------------------------------------------------
# Token from @BotFather. The server uses it to verify Mini App initData and Login Widget data.
BOT_TOKEN=
# Any long random string; the server and the bot authenticate each other with it.
INTERNAL_SECRET=

# --- Game server ----------------------------------------------------------------------------
# In docker-compose the password is read from secrets/pg_password.txt; put the same value here.
DATABASE_URL=postgres://shellter:CHANGE_ME@postgres:5432/shellter
# Long random string for signing session tokens.
JWT_SECRET=
# Public https address of the game (links in notifications, Mini App URL).
PUBLIC_URL=https://game.example.com
# Empty disables the admin panel at /admin/.
ADMIN_PASSWORD=
# Secret part of the AdsGram Reward URL (see docs/SETUP.md). Empty disables ad rewards.
ADS_REWARD_SECRET=
# Extra origins allowed to call the API, comma separated. Empty = same origin only.
CORS_ORIGINS=
RATE_LIMIT=240
LOG_LEVEL=info
SERVER_PORT=3000

# --- Client build (public values, baked into the bundle) --------------------------------------
# Bot username without @, for "Open in Telegram", invites and the Login Widget.
BOT_USERNAME=
# AdsGram block id of the rewarded block. Empty = no ads in production.
ADSGRAM_BLOCK_ID=

# --- Bot ------------------------------------------------------------------------------------
# Where the bot reaches the game server. Same compose project: http://server:3000
SERVER_INTERNAL_URL=http://server:3000
# Address Telegram opens as the Mini App (https only).
MINI_APP_URL=https://game.example.com
# polling needs no inbound port; webhook needs WEBHOOK_URL and WEBHOOK_SECRET.
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
# Shown by /terms, e.g. @your_support_account
SUPPORT_CONTACT=
BROADCAST_RPS=25
BOT_INTERNAL_BIND=127.0.0.1
