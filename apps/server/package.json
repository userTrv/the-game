{
  "name": "@shellter/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/main.js --sourcemap && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@shellter/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
