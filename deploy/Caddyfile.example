# Example for a host where ports 80/443 are already taken by an SNI router (for instance nginx
# stream in front of a VPN). The router passes TLS for the game's domain to this Caddy on a
# local port; Caddy terminates TLS and proxies to the game server.
#
# 1. In the SNI router, send `game.example.com` to 127.0.0.1:8443.
# 2. Certificates: the HTTP-01 and TLS-ALPN-01 challenges need ports 80/443, which Caddy does
#    not own here. Either let the router forward ACME requests, or use a DNS challenge
#    (needs a Caddy build with your DNS provider's module), or point `tls` at existing files.
# 3. Check the file before reloading:  caddy validate --config /etc/caddy/Caddyfile

{
	# Caddy does not bind 80/443 on this host.
	auto_https disable_redirects
	https_port 8443
}

game.example.com:8443 {
	bind 127.0.0.1
	# tls /etc/ssl/game/fullchain.pem /etc/ssl/game/privkey.pem

	encode zstd gzip

	# Telegram webhook, only when the bot runs on this host with BOT_MODE=webhook.
	# handle /telegram/webhook* {
	# 	reverse_proxy 127.0.0.1:8082
	# }

	# The bot's internal API and the server's /internal/* must never be reachable from outside.
	@internal path /internal/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The game is embedded by Telegram clients; do not send X-Frame-Options: DENY.
		Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
	}

	# Hashed build assets and sprite atlases can be cached for a long time.
	@static path /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000
}
